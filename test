)


def query_cosmosdb(
    container: ContainerProxy, period: int, model: str, logger: logging.Logger
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    """
    Query Cosmos DB for answers and feedbacks within a specified time period,
    filtered by a specific model.

    Args:
        container (ContainerProxy): The Cosmos DB container to query.
        period (int): The number of days to look back from the current date.
        model (str): The model type to filter answers and feedbacks by (e.g., "gpt-4o").
        logger (Logger): A logging object to record informational messages.

    Returns:
        tuple: A tuple containing two lists:
            - answers_per_model (list): List of answers associated with the specified model.
            - feedbacks_per_model (list): List of feedbacks associated with the specified model.

    """
    if model not in ["gpt-4o", "cache"]:
        logger.info(
            f"Invalid model '{model}' for query search. Please use 'gpt-4o' or 'cache'."
        )
        return [], []

    current_datetime = datetime.now()
    begin_ts = (current_datetime - timedelta(days=period)).timestamp()
    answerquery = f"SELECT * FROM c WHERE c._ts >= {begin_ts} AND (c.type = @type1 OR c.type= @type2)"
    feedbackquery = f"SELECT * FROM c WHERE c._ts >= {begin_ts} AND c.type = @type"

    # answers
    answer_items = container.query_items(
        query=answerquery,
        parameters=[
            {"name": "@type1", "value": "NEW_ANSWER"},
            {"name": "@type2", "value": "GENERATE_WITHOUT_CACHE"},
        ],
        enable_cross_partition_query=True,
    )

    answers = [
        answer
        for answer in answer_items
        if model in answer.get("modelMetaData", {}).get("modelType", "")
    ]

    # feedbacks
    if model == "cache":
        feedback_items = container.query_items(
            query=feedbackquery,
            parameters=[{"name": "@type", "value": "NEW_FEEDBACK_CACHED"}],
            enable_cross_partition_query=True,
        )
        feedback_reasons = container.query_items(
            query=feedbackquery,
            parameters=[{"name": "@type", "value": "NEW_FEEDBACK_CACHED_REASON"}],
            enable_cross_partition_query=True,
        )

    else:
        feedback_items = container.query_items(
            query=feedbackquery,
            parameters=[{"name": "@type", "value": "NEW_FEEDBACK"}],
            enable_cross_partition_query=True,
        )
        feedback_reasons = []

    feedbacks = [
        feedback
        for feedback in feedback_items
        if model
        in feedback.get("history", [{}])[-1]
        .get("modelMetaData", {})
        .get("modelType", "")
    ]

    feedback_reasons = [reason for reason in feedback_reasons]

    return answers, feedbacks, feedback_reasons


def get_data(
    container: ContainerProxy,
    timedelta_days: int,
    model: str,
    mappings: Dict[str, Any],
    logger: logging.Logger,
) -> Dict[str, Dict[str, Any]]:
    """
    Retrieves and processes data from a database, aggregating various metrics based on the given parameters.

    Args:
        container: The database container from which data is queried.
        timedelta_days: The number of days to look back when querying the data.
        model: The model type to filter the data by. Options are 'both', 'gpt4', or 'gpt3'.
        mappings: A dictionary of mappings to be used in processing the data.
        logger: The logger object to log warnings and information.

    Returns:
        Dict[str, Dict[str, Any]]: A dictionary containing the aggregated data, organized into various categories.
    """
    logger.info("[INIT] Querying Cosmosdb...")
    result = {}
    answers, feedbacks, _ = query_cosmosdb(container, timedelta_days, model, logger)
    cache_answers, cache_feedbacks, cache_feedback_reasons = query_cosmosdb(
        container, timedelta_days, "cache", logger
    )
    logger.info("[DONE] Querying Cosmosdb...")

    if len(answers) == 0:
        logger.warning(
            "[ERROR] No answers found in this period. Cannot calculate metrics!"
        )
        return None
    else:
        logger.info("[INIT] Calculating metrics...")
        result["general_info"] = general_information(
            answers, feedbacks, cache_answers, cache_feedbacks, cache_feedback_reasons
        )
        result["cache_metrics"] = cache_metrics(cache_feedbacks)
        result["cache_info"] = cache_info(cache_feedbacks, cache_feedback_reasons)

        result["per_user_info"] = user_aggregation(answers, feedbacks)
        result["document_info"] = document_info(
            answers,
            feedbacks,
            mappings,
            level="doc",
        )

        result["document_info_per_user"] = document_info_per_user(answers, mappings)

        result["subject_info"] = document_info(
            answers,
            feedbacks,
            mappings,
            level="subject",
        )
        result["subject_info_per_user"] = subject_info_per_user(answers, mappings)
        logger.info("[DONE] Calculating metrics...")

    return result

