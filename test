        step3 = [{"role": "user", "content": prompt}]

        client = openai.AzureOpenAI(
            base_url=f"{chat_base_url}openai/deployments/{chat_deployment_id}",
            api_key=chat_key,
            api_version=api_version,
        )

        completion = client.chat.completions.create(
            model=chat_deployment_id,
            messages=step2 + step3,
            temperature=0,
            seed=0,
            extra_body={
                "data_sources": [
                    {
                        "type": "azure_search",
                        "parameters": {
                            "index_name": search_index_name,
                            "endpoint": search_endpoint,
                            "key": search_key,
                            "query_type": "vector",
                            "fields_mapping": {
                                "vector_fields": ["content_vector"],
                                "url_field": "url",
                                "title_field": "title",
                                "filepath_field": "filepath",
                                "content_fields": ["content"],
                            },
                            "in_scope": True,
                            "top_n_documents": n_returned_documents,
                            "role_information": llm_context,
                            "embedding_dependency": {
                                "type": "deployment_name",
                                "deployment_name": embedding_deployment_id,
                            },
                            "strictness": strictness,
                        },
                    }
                ]
            },
        )

        validated = OpenAIResponse.model_validate(completion.model_dump())

        logging.info("AzureOpenAI API response:")
        logging.info(validated.model_dump_json())

        response = format_response(
            response=validated,
            completion_time=int((time.time() - started) * 1000),
            prompt=prompt,
            history=messages,
            prompt_version=llm_context,
            model_version=chat_deployment_id,
            model_type=used_model,
        )

        logging.info("Final response:")
        logging.info(response.model_dump_json())

        return func.HttpResponse(status_code=200, body=response.model_dump_json())


class CosmosDBHandler:
    def __init__(self):
        connection_str = os.environ["CosmosDBConnectionString"]
        db_name = os.environ["CosmosDBDatabaseName"]
        self.client = CosmosClient.from_connection_string(connection_str)
        self.database = self.client.create_database_if_not_exists(id=db_name)
        self.answer_container = self.database.create_container_if_not_exists(
            id="answers", partition_key=PartitionKey(path="/sessionId")
        )
        self.question_container = self.database.create_container_if_not_exists(
            id="questions", partition_key=PartitionKey(path="/sessionId")
        )

    def add_answer(self, answer):
        try:
            answer_data = answer.model_dump()
            self.answer_container.create_item(body=answer_data)
        except ValidationError as e:
            print(f"Data validation error: {e}")

    def get_answer(self, answer_id: str):
        try:
            answer_data = self.answer_container.read_item(
                item=answer_id, partition_key=answer_id
            )
            return answer_data
        except ValidationError as e:
            print(f"Data validation error: {e}")
            return None

    def add_question(self, question):
        try:
            question_data = question.model_dump()
            self.question_container.create_item(body=question_data)
        except ValidationError as e:
            print(f"Data validation error: {e}")

    def get_question(self, question_id: str):
        try:
            question_data = self.question_container.read_item(
                item=question_id, partition_key=question_id
            )
            return question_data
        except ValidationError as e:
            logging.error(f"Data validation error: {e}")
            return None


def get_chat_session(sessionId: str, db: CosmosDBHandler) -> list:
    # Get questions
    query = (
        "SELECT * FROM questions q WHERE q.sessionId = @sessionId ORDER BY q._ts ASC"
    )
    params = [dict(name="@sessionId", value=sessionId)]
    results = db.answer_container.query_items(
        query=query, parameters=params, enable_cross_partition_query=False
    )
    questions = [x for x in results]

    # Get answers
    query = "SELECT * FROM answers a WHERE a.sessionId = @sessionId ORDER BY a._ts ASC"
    params = [dict(name="@sessionId", value=sessionId)]
    results = db.answer_container.query_items(
        query=query, parameters=params, enable_cross_partition_query=False
    )
    answers = [x for x in results]

    # Yes, this is O(n^2) complexity. No, it shouldn't be a problem unless we hit really large sessions
    sessionlist = []
    for question in questions:
        for answer in answers:
            if question["id"] == answer["id"]:
                sessionlist.append((question, answer))

    # Sort by timestamp
    sessionlist = sorted(sessionlist, key=lambda x: x["_ts"])

    return sessionlist


