import ast
from constants.pydantic_classes import OpenAIResponse, ChatResponse
from helper_functions.reformatting import reformat_citations
from typing import Optional


def format_response(
    response: OpenAIResponse,
    completion_time: int,
    prompt: str,
    history: list,
    prompt_version: str,
    model_version: str,
    model_type: str,
    cache_documents: Optional[str],
) -> ChatResponse:
    """
    Formats the response from an OpenAI model into a structured output, including
    metadata about the model and usage statistics. The formatted response can include
    source documents and citation information based on the model type.

    Args:
        response (OpenAIResponse): The response object from the OpenAI model containing
        the model's answer and usage statistics.
        completion_time (int): The time taken to complete the response, in milliseconds.
        prompt (str): The input prompt that was provided to the model.
        history (List[Dict[str, str]]): A list of dictionaries representing the chat history,
        with each dictionary containing a "role" and "content".
        prompt_version (str): The version of the prompt used in the request.
        model_version (str): The version of the model used to generate the response.
        model_type (str): The type of model used, such as "cache" or others.
        cache_documents (Optional[str]): A string representing a list of cache document retrieved
        from Azure Search database, if applicable.

    Returns:
        ChatResponse: An instance of the `ChatResponse` class containing the validated
        and formatted response.
    """
    tmp = {
        "answer": reformat_citations(response.choices[0].message.content),
        "question": prompt,
        "chat_history": history,
    }

    # get source documents
    if model_type == "cache" and cache_documents:
        tmp["source_documents"] = ast.literal_eval(cache_documents)
    else:
        refs = []
        if response.choices[0].message.context:
            for idx, citation in enumerate(
                response.choices[0].message.context.citations
            ):
                refs.append(
                    {
                        "id": str(idx + 1),
                        "title": citation.title,
                        "filepath": (
                            "" if citation.filepath is None else citation.filepath
                        ),
                        "url": citation.url,
                        "content": citation.content.encode("utf-8"),
                    }
                )
        tmp["source_documents"] = refs

    # metadata
    tmp["model_info"] = {
        "prompt_version": prompt_version if prompt_version is not None else "missing",
        "model_version": model_version if model_version is not None else "missing",
        "model_type": model_type if model_type is not None else "missing",
    }
    tmp["model_usage"] = {
        "completion_tokens": response.usage.completion_tokens,
        "prompt_tokens": response.usage.prompt_tokens,
        "total_tokens": response.usage.completion_tokens + response.usage.prompt_tokens,
        "completion_time": completion_time,
    }
    return ChatResponse.model_validate(tmp)



