from datetime import date, timedelta

sites = fetcher.config_paths["sharepoint_sites"]

print("Beschikbare kennisbanken/categories:")
for kb, categories in sites.items():
    print(f"- {kb}: {list(categories.keys())}")

# Voor deze spike:
kennisbank = next(iter(sites))
category = next(iter(sites[kennisbank]))

print("\nGebruik:")
print("kennisbank =", kennisbank)
print("category   =", category)

processed, skipped = fetcher.retrieve_sharepoint_data_incremental(
    kennisbank=kennisbank,
    category=category,
    sync_date=date.today() - timedelta(days=1),
)

print("\n✓ Ophalen klaar")
print("Processed:", len(processed))
print("Skipped  :", len(skipped))
print("Data to process:", len(fetcher.data_to_be_processed))
