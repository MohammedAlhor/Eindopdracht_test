async def summarize_question(query: str) -> str:
    """Summarizes a question in a few words."""
    logger.info(f"Starting summarization for query: {query}")

    messages = [{"role": "system", "message_content": prompt_summarize_question}]
    messages.extend([{"role": "user", "message_content": query}])
    messages_lc = convert_to_langchain_messages(messages=messages)

    try:
        response = await chat_model.ainvoke(messages_lc)
        logger.info("Received response from chat model for summarization.")
        summary = validate_summarize_response(response.content)
        logger.info(f"Extracted summary: {summary}")
    except Exception as e:
        logger.error(f"Error during summarization: {e}")
        raise HTTPException(status_code=500, detail=str(e))
    
    return summary

    

async def rewrite_question(query: str, chat_history: list[dict[str, str]]) -> str:
    """Rewrites a question based on chat history."""
    logger.info(f"Starting rewrite for query: {query} with chat history length: {len(chat_history)}")

    context_and_question = f"Context of the chat that you can use to rewrite the question to a standalone question: \n\n{json.dumps(chat_history)}\n\nQuestion to rewrite:\n{query}"
    messages = [{"role": "system", "message_content": prompt_rewrite_question}]
    messages.extend([{"role": "user", "message_content": context_and_question}])
    messages_lc = convert_to_langchain_messages(messages=messages)

    try:
        response = await chat_model.ainvoke(messages_lc)
        logger.info("Received response from chat model for rewrite.")
        logger.info(f"Input for validation: {response.content}\ntype: {type(response.content)}")
        rewritten_question = validate_rewrite_response(response.content)
        logger.info(f"Rewritten question: {rewritten_question}")
    except Exception as e:
        logger.error(f"Error during question rewrite: {e}")
        raise HTTPException(status_code=500, detail=str(e))

    return rewritten_question



def convert_to_langchain_messages(messages: list[dict[str, str]]):
    """Helper function that converts messages into langchain messages."""
    converted = []
    for msg in messages:
        role = msg.get("role")
        content = msg.get("message_content") or msg.get("content") or msg.get("message")
        if role == "system":
            converted.append(SystemMessage(content=content))
        elif role == "user":
            converted.append(HumanMessage(content=content))
        elif role == "assistant":
            converted.append(AIMessage(content=content))
    return converted



async def retrieve_answer_for_user_question(query: str, chat_history: list[dict], fonds: str):
    """Retrieves an answer for the user question by making use of the RAG methodology."""
    logger.info(f"Retrieving answer for query: {query} with fonds: {fonds}")

    if chat_history:
        logger.info("Chat history detected, attempting to rewrite question.")
        query_rewritten = await rewrite_question(query=query, chat_history=chat_history)
        logger.info(f"Rewritten query: {query_rewritten}")
        query = query_rewritten

    try:
        filter_str = f"category == '{fonds}'"
        sourcechunks = vector_db.search_with_query_string(query=query,
                                                          # filter_str=filter_str
                                                            )
        logger.info(f"Found {len(sourcechunks[0])} source chunks.")
        if len(sourcechunks[0]) == 0:
            raise HTTPException(status_code=404, detail=f"No content for fonds {fonds}")
    except Exception as e:
        logger.error(f"Error during vector DB search: {e}")
        raise HTTPException(status_code=500, detail=str(e))

    # create subchunks using sentence-based chunking to avoid overlap issues
    subchunks = []
    for sourcechunk in sourcechunks[0]:
        # Use sentence-based chunking to eliminate overlap problems
        subchunks.extend(chunk_text_by_sentences(text=sourcechunk["text"],
                                                sourcechunk_id=str(sourcechunk["id"]),
                                                sourcechunk_url=sourcechunk["entity"].get("source_page", "")
                                                )
                         )

    # create context (json string with relevant keys)
    context = create_context_from_subchunks(subchunks=subchunks)

    # create messages
    chat_history_lc = convert_to_langchain_messages(chat_history)
    system_message = SystemMessage(content=prompt_retrieve_answer)
    user_message = HumanMessage(content=f"Context:\n{context}\n\nQuestion: {query}")
    messages = [system_message] + chat_history_lc + [user_message]

    # use language model
    try:
        response = await chat_model.ainvoke(messages)
        logger.info("Received response from chat model for answer retrieval.")
        logger.info(f"Input for validation in retrieve_answer_for_user_question: {response.content}\ntype: {type(response.content)}")
        answer_with_references, status_code = validate_retrieve_answer_response(response.content)

    except Exception as e:
        logger.error(f"Error parsing final answer: {e}")
        raise HTTPException(status_code=500, detail=str(e))

    if status_code == "LLM_NO_ANSWER":
        return "0x"

    # Process the answer and return it for existing footnote handling
    # Note: The existing footnote logic in routes.py will handle the superscript conversion
    sourcechunks_output = []
    for sourcechunk in sourcechunks[0]:
        sourcechunk_output = {
            "sourcechunk_id": str(sourcechunk["id"]),
            "sourcechunk_content": sourcechunk["text"],
            "sourcechunk_url": sourcechunk["entity"]["source_page"],
            "sourcechunk_category": sourcechunk["entity"]["category"],
            "sourcechunk_kennisbank": sourcechunk["entity"]["kennisbank"]
        }
        sourcechunks_output.append(sourcechunk_output)

    # Debug logging to verify ID consistency
    logger.info(f"LLM_UTILS DEBUG - sourcechunk IDs in subchunks: {set(s.get('sourcechunk_id') for s in subchunks)}")
    logger.info(f"LLM_UTILS DEBUG - sourcechunk IDs in output: {set(s.get('sourcechunk_id') for s in sourcechunks_output)}")

    return answer_with_references, sourcechunks_output, subchunks


def match_subchunks_and_add_footnote_numbers(answer: str, subchunks: list[dict]):
    """
    Finds subchunk metadata and adds footnote numbers to bracketed content.
    Also validates that all footnote references exist in available subchunks.
    """
    import re
    
    # First, validate footnote references and clean up invalid ones
    validated_answer, warnings = validate_footnote_references(answer, subchunks)
    
    # Log any warnings about invalid footnotes
    for warning in warnings:
        logger.warning(warning)
    
    subchunk_matches = {}

    # Find all bracketed contents in the validated answer
    matches = re.findall(r"\[(.*?)\]", validated_answer)

    for i, match in enumerate(matches, start=1):
        # Replace each bracketed content with numbered footnote format
        footnote_marker = f"[{match}:{i}]"
        validated_answer = validated_answer.replace(f"[{match}]", footnote_marker, 1)  # Replace only first occurrence
        
        # Link the match with the subchunk metadata using the footnote number as key
        try:
            parts = match.split(":")
            if len(parts) >= 2:
                sourcechunk_id = parts[0]
                subchunk_id = parts[1]
                
                # Find matching subchunk
                found_match = False
                for subchunk in subchunks:
                    if (str(sourcechunk_id) == str(subchunk.get("sourcechunk_id")) and 
                        str(subchunk_id) == str(subchunk.get("subchunk_id"))):
                        # Use the footnote number (i) as the key, not an arbitrary index
                        subchunk_matches[i] = subchunk
                        found_match = True
                        break
                
                # Log if we couldn't find a match (this should be rare after validation)
                if not found_match:
                    logger.warning(f"Footnote reference [{match}] passed validation but couldn't find matching subchunk")
                    
        except (ValueError, IndexError):
            # If parsing fails, skip this match
            logger.warning(f"Failed to parse footnote reference: [{match}]")
            continue

    logger.info(f"Processed {len(matches)} footnote references, {len(subchunk_matches)} successfully linked to subchunks")
    logger.info(f"SUBCHUNK MATCHES KEYS: {list(subchunk_matches.keys())}")
    if warnings:
        logger.info(f"Removed {len(warnings)} invalid footnote references")

    # Convert subchunk matches to use display_text to avoid overlaps in UI
    display_subchunk_matches = get_display_text_for_subchunk_matches(subchunk_matches)

    return validated_answer, display_subchunk_matches
