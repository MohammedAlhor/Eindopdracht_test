# ============================================================
# DOCUMENT INTELLIGENCE – TABLE IMPACT QUICK SCAN
#
# Doel van deze spike:
# 1. Bestaande ChatAPG VectorDatabase-route hergebruiken
# 2. Documenten via de bestaande fetch/download-flow ophalen
# 3. Dezelfde Azure Document Intelligence-call gebruiken als productie
# 4. result.tables inventariseren
# 5. Direct eerste signalen opleveren voor impact op:
#       nodes -> chunks -> retrieval -> LLM
#
# Geen wijzigingen aan productiecode.
# ============================================================


# ------------------------------------------------------------
# 1. Imports + bestaande projectcomponenten
# ------------------------------------------------------------

import inspect
import pandas as pd

from azure.ai.documentintelligence.models import DocumentContentFormat
from sharepoint_extraction import SharePointDataFetcher


print("✓ Azure Document Intelligence beschikbaar")
print("✓ SharePointDataFetcher beschikbaar")


# ------------------------------------------------------------
# 2. Bestaande fetcher initialiseren
#
# We gebruiken bewust de bestaande projectklasse:
# - config
# - credentials
# - SharePoint download
# - DocumentIntelligenceClient
# zitten daar al in.
# ------------------------------------------------------------

print("\nConstructor:")
print(inspect.signature(SharePointDataFetcher))

fetcher = SharePointDataFetcher()


# ------------------------------------------------------------
# 3. Bestaande projectflow gebruiken om documenten op te halen
#
# Zoek automatisch de bestaande publieke entrypoint in de klasse,
# zodat we geen nieuwe fetch/download-route bouwen.
# ------------------------------------------------------------

candidate_methods = [
    name
    for name in dir(fetcher)
    if not name.startswith("_")
    and any(
        word in name.lower()
        for word in [
            "fetch",
            "load",
            "process",
            "document",
            "download",
        ]
    )
    and callable(getattr(fetcher, name))
]

print("\nBeschikbare relevante methods:")
print(candidate_methods)

# Preferente bestaande entrypoints, in logische volgorde
preferred_methods = [
    "fetch",
    "load",
    "process",
    "process_documents",
    "fetch_documents",
    "download_documents",
]

entrypoint = next(
    (name for name in preferred_methods if name in candidate_methods),
    None,
)

if entrypoint is None:
    raise RuntimeError(
        "Geen bestaande publieke fetch/process-entrypoint gevonden. "
        f"Beschikbaar: {candidate_methods}"
    )

print(f"\n✓ Gebruik bestaande entrypoint: {entrypoint}()")

getattr(fetcher, entrypoint)()


# ------------------------------------------------------------
# 4. Document Intelligence-resultaten analyseren
#
# De bestaande flow gebruikt temp_ref voor gedownloade documenten.
# We nemen alleen documenten die daadwerkelijk lokaal beschikbaar zijn
# en draaien exact dezelfde DI-call:
#       prebuilt-layout -> result
#
# Voor deze spike kijken we bewust naar result.tables.
# ------------------------------------------------------------

documents = [
    item
    for item in getattr(fetcher, "data_to_be_processed", [])
    if item.get("temp_ref")
]

print(f"\nDocumenten beschikbaar voor analyse: {len(documents)}")

inventory = []

for item in documents:
    try:
        with open(item["temp_ref"], "rb") as f:
            result = fetcher.docint_client.begin_analyze_document(
                "prebuilt-layout",
                body=f,
                output_content_format=DocumentContentFormat.MARKDOWN,
            ).result()

        for table_index, table in enumerate(result.tables or [], start=1):
            cells = table.cells or []

            header_cells = sum(
                getattr(cell, "kind", None)
                in {"columnHeader", "rowHeader", "stubHead"}
                for cell in cells
            )

            merged_cells = sum(
                (getattr(cell, "row_span", 1) or 1) > 1
                or (getattr(cell, "column_span", 1) or 1) > 1
                for cell in cells
            )

            empty_cells = sum(
                not (getattr(cell, "content", "") or "").strip()
                for cell in cells
            )

            inventory.append({
                "document": (
                    item.get("name")
                    or item.get("title")
                    or item.get("filename")
                    or item.get("temp_ref")
                ),
                "table": table_index,
                "rows": table.row_count,
                "columns": table.column_count,
                "cells": len(cells),
                "header_cells": header_cells,
                "merged_cells": merged_cells,
                "empty_cells": empty_cells,
            })

    except Exception as exc:
        print(
            f"SKIP: "
            f"{item.get('name') or item.get('title') or item.get('temp_ref')} "
            f"-> {exc}"
        )


tables_df = pd.DataFrame(inventory)


# ------------------------------------------------------------
# 5. Resultaat / eerste impactsignalen
# ------------------------------------------------------------

print("\n" + "=" * 72)
print("DOCUMENT INTELLIGENCE – TABLE IMPACT QUICK SCAN")
print("=" * 72)

print(f"Documenten bekeken : {len(documents)}")
print(f"Tabellen gevonden  : {len(tables_df)}")

if tables_df.empty:
    print("\nGeen tabellen gevonden in de geanalyseerde documenten.")

else:
    display(tables_df)

    print("\nSNELLE SIGNALEN")
    print(f"- Grootste tabel          : {tables_df['rows'].max()} rijen")
    print(f"- Meeste kolommen         : {tables_df['columns'].max()}")
    print(f"- Tabellen met headers    : {(tables_df['header_cells'] > 0).sum()}")
    print(f"- Tabellen met merges     : {(tables_df['merged_cells'] > 0).sum()}")
    print(f"- Tabellen met lege cellen: {(tables_df['empty_cells'] > 0).sum()}")

    print("\nEERSTE IMPACTCHECK")
    print(
        "- Grote tabellen kunnen botsen met huidige chunk-grootte / atomic-block aanpak."
    )
    print(
        "- Merged cells en meerdere headerlagen kunnen informatie verliezen bij flattening."
    )
    print(
        "- Lege cellen moeten onderscheidbaar blijven van 0, '-' of ontbrekende waarden."
    )
    print(
        "- Tabellen met veel structuur vragen waarschijnlijk extra context "
        "bij node/retrieval (headers, sectie, bron)."
    )
