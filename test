def format_response(
    response: OpenAIResponse,
    completion_time: int,
    prompt: str,
    history: list,
    prompt_version: str,
    model_version: str,
    model_type: str,
    cls=ChatResponse,
):
    tmp = {
        "answer": reformat_citations(response.choices[0].message.content),
        "question": prompt,
        "chat_history": history,
    }

    refs = []
    if response.choices[0].message.context:
        for idx, citation in enumerate(response.choices[0].message.context.citations):
            refs.append(
                {
                    "id": str(idx + 1),
                    "title": citation.title,
                    "filepath": (
                        "" if citation.filepath is None else citation.filepath
                    ),
                    "url": citation.url,
                    "content": citation.content.encode("utf-8"),
                }
            )
    tmp["source_documents"] = refs
    tmp["model_info"] = {
        "prompt_version": prompt_version if prompt_version is not None else "missing",
        "model_version": model_version if model_version is not None else "missing",
        "model_type": model_type if model_type is not None else "missing",
    }
    tmp["model_usage"] = {
        "completion_tokens": response.usage.completion_tokens,
        "prompt_tokens": response.usage.prompt_tokens,
        "total_tokens": response.usage.completion_tokens + response.usage.prompt_tokens,
        "completion_time": completion_time,
    }
    return cls.model_validate(tmp)


