# Zoek alle text/webpart-controls waarin een HTML-tabel voorkomt
table_controls = []

for i, control in enumerate(canvas_content):
    if control.get("controlType") != 4:
        continue

    inner_html = control.get("innerHTML", "") or ""

    if "<table" in inner_html.lower():
        table_controls.append(
            {
                "control_index": i,
                "control_id": control.get("id"),
                "html": inner_html,
                "markdown": md_tight(
                    inner_html,
                    base_url=base_url,
                ),
            }
        )

print(f"Aantal canvas-controls: {len(canvas_content)}")
print(f"Aantal controls met tabel(len): {len(table_controls)}")

for i, table in enumerate(table_controls, start=1):
    print("\n" + "=" * 100)
    print(f"TABEL-CONTROL {i}")
    print(f"control_index: {table['control_index']}")
    print(f"control_id:    {table['control_id']}")

    print("\nRAW HTML:")
    print(table["html"])

    print("\nMARKDOWN:")
    print(table["markdown"])
