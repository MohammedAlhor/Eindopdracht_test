from datetime import date, timedelta

# Gebruik de site-context die al bewezen werkt
kennisbank = "PU"
category = "PWRI"

documents = []

# Zoek terug in de tijd, maar stop zodra we 3 documenten hebben
for days_back in range(1, 31):

    sync_date = date.today() - timedelta(days=days_back)

    print(f"Check {sync_date}...")

    processed, skipped = fetcher.retrieve_sharepoint_data_incremental(
        kennisbank=kennisbank,
        category=category,
        sync_date=sync_date,
    )

    found = [
        item
        for item in fetcher.data_to_be_processed
        if item.get("temp_ref")
    ]

    documents.extend(found)

    # duplicaten eruit
    documents = list({
        item["temp_ref"]: item
        for item in documents
    }.values())

    if len(documents) >= 3:
        documents = documents[:3]
        break

print(f"\n✓ Testset klaar: {len(documents)} documenten")

for i, item in enumerate(documents, 1):
    print(i, item.get("name") or item.get("title") or item.get("temp_ref"))
