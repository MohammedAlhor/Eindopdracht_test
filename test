tables = []

for page in get_all_sitepages():

    page_url = page["FileRef"]
    relative_url = page_url.split("/SitePages/", 1)[-1]
    relative_url = f"SitePages/{relative_url}"

    try:
        canvas = get_sitepage_canvas(
            base_url=site_base_url,
            page_relative_url=relative_url,
        )
    except Exception as e:
        print(f"SKIP: {relative_url} -> {e}")
        continue

    table_number = 0

    for control in canvas:

        if control.get("controlType") != 4:
            continue

        html = control.get("innerHTML", "") or ""
        soup = BeautifulSoup(html, "html.parser")

        for html_table in soup.find_all("table"):

            table_number += 1

            rows = html_table.find_all("tr")
            cells_per_row = [
                len(row.find_all(["th", "td"]))
                for row in rows
            ]

            tables.append({
                "page_title": page.get("Title"),
                "page_url": page_url,
                "table_number": table_number,
                "rows": len(rows),
                "columns": max(cells_per_row, default=0),
                "markdown": md_tight(
                    str(html_table),
                    base_url=site_base_url,
                ),
                "html": str(html_table),
            })


tables_df = pd.DataFrame(tables)

print(f"Pagina's onderzocht : {len(get_all_sitepages())}")
print(f"Tabellen gevonden   : {len(tables_df)}")
print(f"Pagina's met tabel  : {tables_df['page_url'].nunique() if len(tables_df) else 0}")

