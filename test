def replace_abbreviations(text: str, abbreviations: dict = abbreviations) -> str:
    sorted_abbreviations = sorted(abbreviations.keys(), key=len, reverse=True)

    for abbreviation in sorted_abbreviations:
        full_form = abbreviations[abbreviation]
        pattern = re.compile(rf"\b{re.escape(abbreviation)}\b")
        text = pattern.sub(f"{full_form} ({abbreviation})", text)

    return text


def reformat_citations(input_string):
    pattern = r"\[doc(\d+)\]"

    def replace_citation(match):
        citation_number = int(match.group(1))
        return f"[{citation_number}]"

    formatted_string = re.sub(pattern, replace_citation, input_string)
    citation_numbers = set(
        int(match.group(1)) for match in re.finditer(pattern, input_string)
    )
    if len(citation_numbers) > 1:
        formatted_string = re.sub(
            r"\[([\d,]+)\]",
            lambda match: f'[{",".join(match.group(1).split(","))}]',
            formatted_string,
        )
    return formatted_string


def standalone_question(llm: Any, chat_history: str, followup_question: str) -> str:
    """
    Given chat history, use a llm to rephrase the user question to a standalone question useable for vector search.
    Tries to replace 'this' and 'it' etc with their actual meanings as given earlier in the chat history.
    """
    if len(chat_history) == 0:
        return followup_question
    else:
        qa = ""
        for i, (question, answer) in enumerate(chat_history):
            qa += f"QUESTION {i+1}:\n {question}\n\n"
            qa += f"ANSWER {i+1}:\n {answer}\n\n"
        chat_history = qa

    rephrase_template = f"""
Given the following conversation and follow-up question,
rephrase the follow-up question to be a standalone question in the original language.
Convert the question into a query for a vectorstore in the original language,
and strip out information that is not relevant for the retrieval task.
Give back only the standalone question.
----------
CHAT HISTORY:
{chat_history}
----------
FOLLOWUP QUESTION:
{followup_question}
----------
Standalone question:
"""
    return llm.invoke(rephrase_template).content


