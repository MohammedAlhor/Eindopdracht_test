site_base_url_http = site_base_url.rstrip("/")

if not site_base_url_http.startswith(("http://", "https://")):
    site_base_url_http = "https://" + site_base_url_http


def get_all_sitepages():
    url = (
        f"{site_base_url_http}/_api/web/lists/getbytitle('Site Pages')/items"
        "?$select=Title,FileRef&$top=5000"
    )

    pages = []

    while url:
        response = requests.get(url, headers=headers)
        response.raise_for_status()

        data = response.json()["d"]
        pages.extend(data["results"])
        url = data.get("__next")

    return pages


pages = get_all_sitepages()
tables = []

for page in pages:
    page_url = page["FileRef"]

    if "/SitePages/" not in page_url:
        continue

    page_relative_url = "SitePages/" + page_url.split("/SitePages/", 1)[1]

    try:
        canvas = get_sitepage_canvas(
            base_url=site_base_url_http,
            page_relative_url=page_relative_url,
        )
    except Exception as e:
        print(f"SKIP: {page_relative_url} -> {e}")
        continue

    for control_index, control in enumerate(canvas):
        if control.get("controlType") != 4:
            continue

        inner_html = control.get("innerHTML", "") or ""
        soup = BeautifulSoup(inner_html, "html.parser")

        for table_index, html_table in enumerate(soup.find_all("table"), start=1):
            rows = html_table.find_all("tr")
            cells_per_row = [
                len(row.find_all(["th", "td"]))
                for row in rows
            ]

            tables.append({
                "page_title": page.get("Title"),
                "page_url": page_url,
                "control_index": control_index,
                "table_index": table_index,
                "rows": len(rows),
                "columns": max(cells_per_row, default=0),
                "markdown": md_tight(
                    str(html_table),
                    base_url=site_base_url_http,
                ),
                "html": str(html_table),
            })


tables_df = pd.DataFrame(tables)

print(f"Pagina's onderzocht : {len(pages)}")
print(f"Tabellen gevonden   : {len(tables_df)}")
print(
    f"Pagina's met tabel  : "
    f"{tables_df['page_url'].nunique() if not tables_df.empty else 0}"
)

