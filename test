from pymilvus import MilvusClient, DataType, FieldSchema, CollectionSchema
from models.embedding_model import get_embedding_model
from typing import List, Dict
import os



class Vectordatabase:
    """
    A utility class for managing a Milvus Lite vector database.
    Handles connection, collection setup, data insertion, deletion, querying, and vector search.
    """

    def __init__(self, db_path: str, collection_name: str, subscription_key=None):
        """
        Initializes the vector database and ensures the collection exists.

        Args:
            db_path (str): Path to the local Milvus Lite database.
            collection_name (str): Name of the collection to use or create.
            subscription_key (str, optional): Key for accessing the embedding model.
        """
        self.db_path = db_path
        self.collection_name = collection_name
        self.subscription_key = subscription_key

        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
        self._connect_to_milvus()
        self._create_collection_if_needed()

    def _connect_to_milvus(self):
        """Connects to the Milvus Lite database."""
        self.client = MilvusClient(uri=self.db_path)
        print(f"✅ Connected to Milvus Lite database at {self.db_path}")

    def _create_collection_if_needed(self):
        """Creates the collection with schema and index if it doesn't exist."""
        if not self.client.has_collection(self.collection_name):
            fields = [
                FieldSchema(name="id", dtype=DataType.INT64, is_primary=True, auto_id=True),
                FieldSchema(name="title", dtype=DataType.VARCHAR, max_length=1024),
                FieldSchema(name="source_page", dtype=DataType.VARCHAR, max_length=512),
                FieldSchema(name="text", dtype=DataType.VARCHAR, max_length=1024),
                FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=1536),
                FieldSchema(name="category", dtype=DataType.VARCHAR, max_length=50),
                FieldSchema(name="kennisbank", dtype=DataType.VARCHAR, max_length=50),
                FieldSchema(name="file_type", dtype=DataType.VARCHAR, max_length=50),
                FieldSchema(name="created", dtype=DataType.INT64),
                FieldSchema(name="modified", dtype=DataType.INT64),
                FieldSchema(name="chunk_index", dtype=DataType.INT64),
            ]

            schema = CollectionSchema(fields=fields)

            self.client.create_collection(
                collection_name=self.collection_name,
                schema=schema,
                description="Collection with embedding and metadata"
            )

            index_params = self.client.prepare_index_params()
            index_params.add_index(
                field_name="embedding",
                index_type="IVF_FLAT",
                metric_type="L2",
                params={"nlist": 128}
            )

            self.client.create_index(
                collection_name=self.collection_name,
                index_params=index_params
            )

            print(f"✅ Collection '{self.collection_name}' created and indexed.")
        else:
            print(f"ℹ️ Collection '{self.collection_name}' already exists.")
            self.client.load_collection(self.collection_name)

    def insert_embeddings(self, entities: List[List]):
        """
        Inserts a list of entities into the collection.

        Args:
            entities (List[List]): List of entity data rows to insert.
        """
        self.client.insert(collection_name=self.collection_name, data=entities)
        print("✅ Inserted data into Milvus Lite database.")

    def delete(self, primary_keys: List[int]):
        """
        Deletes entities from the collection by primary key.

        Args:
            primary_keys (List[int]): List of primary keys to delete.
        """
        filter_expr = f"id in {primary_keys}"
        self.client.delete(collection_name=self.collection_name, filter=filter_expr)
        print("✅ Deleted data from Milvus Lite database.")

    def list_collections(self) -> List[str]:
        """
        Lists all collections in the database.

        Returns:
            List[str]: Names of all collections.
        """
        return self.client.list_collections()

    def describe_collection(self) -> Dict:
        """
        Describes the schema and metadata of the current collection.

        Returns:
            Dict: Collection description.
        """
        return self.client.describe_collection(self.collection_name)

    def count_entities(self) -> int:
        """
        Counts the number of entities in the collection.

        Returns:
            int: Number of rows/entities.
        """
        stats = self.client.get_collection_stats(self.collection_name)
        return stats.get("row_count", 0)

    def search(self, filter_str: str, query_vectors: List[List[float]], limit: int = 5,
               metric_type: str = "L2", nprobe: int = 10) -> List[Dict]:
        """
        Searches the collection using vector similarity.

        Args:
            filter_str (str): Optional filter expression.
            query_vectors (List[List[float]]): List of query vectors.
            limit (int): Max number of results to return.
            metric_type (str): Similarity metric (e.g., "L2").
            nprobe (int): Search parameter for IVF index.

        Returns:
            List[Dict]: Search results with metadata.
        """
        results = self.client.search(
            filter=filter_str,
            collection_name=self.collection_name,
            data=query_vectors,
            anns_field="embedding",
            search_param={"metric_type": metric_type, "params": {"nprobe": nprobe}},
            limit=limit,
            output_fields=[
                "title", "source_page", "text", "embedding", "category",
                "kennisbank", "file_type", "created", "modified", "chunk_index"
            ]
        )
        return results

    def query(self, filter_str: str, output_fields: List[str]) -> List[Dict]:
        """
        Queries the collection using a filter expression.

        Args:
            filter_str (str): Filter expression.
            output_fields (List[str]): Fields to return.

        Returns:
            List[Dict]: Query results.
        """
        results = self.client.query(
            collection_name=self.collection_name,
            filter=filter_str,
            output_fields=output_fields,
        )
        return results
    

    def embed_query(self, query: str) -> List[List[float]]:
        """
        Embeds a query string using the embedding model.

        Args:
            query (str): Text query to embed.

        Returns:
            List[List[float]]: Embedded query wrapped in a list.
        """
        embedding_model = get_embedding_model(self.subscription_key)
        embedding = embedding_model.embed_query(query)
        return [embedding]
    

    def search_with_query_string(self, query: str, filter_str: str = "", limit: int = 5,
                                 metric_type: str = "L2", nprobe: int = 10) -> List[Dict]:
        """
        Convenience method: embeds a query string and performs a vector search.

        Args:
            query (str): Text query to embed and search.
            filter_str (str): Optional filter expression.
            limit (int): Max number of results to return.
            metric_type (str): Similarity metric.
            nprobe (int): Search parameter for IVF index.

        Returns:
            List[Dict]: Search results.
        """
        query_vectors = self.embed_query(query)
        return self.search(
            filter_str=filter_str,
            query_vectors=query_vectors,
            limit=limit,
            metric_type=metric_type,
            nprobe=nprobe
        )
