import logging
from typing import Dict, List, Any
from datetime import datetime
import os
from langchain.docstore.document import Document
from application.models.embedding_model import get_embedding_model


class DocumentPreparationPipeline:
    def __init__(self, token_splitter):
        self.token_splitter = token_splitter


    def chunk_content(self, content: str) -> List[Dict[str, Any]]:
        """
        Splits the content into smaller chunks using token_splitter.
        
        Args:
            content (str): The content to be chunked.
        
        Returns:
            List[Dict[str, Any]]: A list of dictionaries, each containing a chunk of content and its index.
        """
        chunks = self.token_splitter.split_text(content)
        return [{"chunk_index": idx, "chunk": chunk} for idx, chunk in enumerate(chunks)]



    def create_langchain_documents(self, data: List[Dict[str, Any]]) -> List[Document]:
        """
        Creates LangChain Document objects with metadata.
        
        Args:
            data (List[Dict[str, Any]]): A list of dictionaries, each containing the URL, content, content type, parent page, and version.
        
        Returns:
            List[Document]: A list of LangChain Document objects.
        """
        langchain_documents = []
        

        for item in data:
            chunks = self.chunk_content(item["content"])
            for chunk in chunks:
                
                # Convert dates to integer timestamps for Milvus
                date_created = datetime.strptime(item["created"], '%Y-%m-%dT%H:%M:%SZ')
                ts_created = int(date_created .timestamp())
                date_modified = datetime.strptime(item["modified"], '%Y-%m-%dT%H:%M:%SZ')
                ts_modified = int(date_modified .timestamp())

                doc = Document(
                    page_content=chunk["chunk"],
                    metadata={
                        "title": item["title"],
                        "source_page": item["source_page"],
                        "created": ts_created,
                        "modified": ts_modified,
                        "file_type": item["file_type"],
                        "category": item["category"],
                        "kennisbank": item["kennisbank"],
                        "chunk_index": str(chunk["chunk_index"])
                    }
                )
                langchain_documents.append(doc)

        return langchain_documents
    

    
    def generate_embeddings(self, docs: List[Document]) -> List[Dict[str, Any]]:
        """
        Generates embeddings for each LangChain Document.
        
        Args:
            docs (List[Document]): A list of LangChain Document objects.
        
        Returns:
            List[Dict[str, Any]]: A list of dictionaries with embeddings and metadata.
        """

        data_with_embeddings = []
        embedding_model = get_embedding_model() 
       
        for doc in docs:
            embedding = embedding_model.embed_query(doc.page_content)
            data_with_embeddings.append({
                "title": doc.metadata.get("title"),
                "source_page": doc.metadata.get("source_page"),
                "text":  doc.page_content,
                "embedding": embedding,
                "category": doc.metadata.get("category"),
                "kennisbank": doc.metadata.get("kennisbank"),
                "file_type": doc.metadata.get("file_type"),
                "created": doc.metadata.get("created"),
                "modified": doc.metadata.get("modified"),
                "chunk_index": doc.metadata.get("chunk_index")
            })
    
        return data_with_embeddings
    
    
    def prepare_data_for_vectordatabase(self, data: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """
        Prepares the data for insertion into the Milvus vector-database in row-oriented format.

        Args:
            data (List[Dict[str, Any]]): A list of dictionaries, each containing the fields:
            - title      
            - source_page
            - text       
            - embedding  
            - category   
            - kennisbank 
            - file_type  
            - created  
            - modified  
            - chunk_index
        Returns:
            List[Dict[str, Any]]: A list of dictionaries, each representing a row of data.
        """
        rows = []

        for item in data:
            row = {
                "title": item["title"],
                "source_page": item["source_page"],
                "text": item["text"],
                "embedding": item["embedding"],
                "category":item["category"],
                "kennisbank": item["kennisbank"],
                "file_type": item["file_type"],
                "created": item["created"],
                "modified": item["modified"],
                "chunk_index": int(item["chunk_index"])
            }
            rows.append(row)

        return rows

