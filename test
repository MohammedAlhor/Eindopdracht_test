)

def get_embedding_model(cfg, subscription_key):
    embedding_model = AzureOpenAIEmbeddings(
        azure_endpoint=cfg['openai']['text_embedding']['endpoint'],
        azure_deployment=cfg['openai']['text_embedding']['deployment_id'],
        api_key=subscription_key,
        api_version=cfg['openai']['text_embedding']['api_version'],
        openai_api_type=cfg['openai']['text_embedding']['api_type'],
        )
    return embedding_model

def embed(embedding_model:AzureOpenAIEmbeddings, text:str) -> List[float]:
        embedding = embedding_model.embed_query(text)
        return embedding

def load_cached_embeddings(cache_path):
    if cache_path.exists():
        with open(cache_path, "rb") as f:
            embeddings = pickle.load(f)
            return embeddings
    else:
        return {}

def cache_embedding(embedding_model, file_path) -> None:
    
    file_name = file_path.name
    # file_name_hash = hashlib.md5(file_name.encode()).hexdigest()

    cached_embeddings = load_cached_embeddings(CACHE_PATH)
    
    if file_name in cached_embeddings.keys():
        print(f"embedding for {file_path.name} is already cached.")
        return
    
    with open(file_path, "r", encoding="utf-8") as f:
        content = f.read()
    
    embedding = embed(embedding_model, content)
    
    print(f"embedding created and cached for {file_name}")

    cached_embeddings[file_name] = embedding
    
    with open(CACHE_PATH, "wb") as f:
        pickle.dump(cached_embeddings, f)

def cache_embedding_from_nodes(nodes) -> None:
    
    cached_embeddings = load_cached_embeddings(CACHE_PATH)
    
    for node in nodes:
        file_name = node.state["source"]["file"]
        content = node.state["content"]
        if file_name in cached_embeddings:
            print(f"embedding for {file_name} already cached")
            continue
        embedding = embed(embedding_model, content)
        print(f"embedding created and cached for {file_name}")
        cached_embeddings[file_name] = embedding
        node.state["embedding"] = embedding
    
    with open(CACHE_PATH, "wb") as f:
        pickle.dump(cached_embeddings, f)

def find_top_k_similar(question_embedding: np.ndarray, cached_embeddings: dict, k: int = 5):
    # Normalize the question embedding
    q_norm = question_embedding / np.linalg.norm(question_embedding)
    
    similarities = []
    for key, emb in cached_embeddings.items():
        emb_norm = emb / np.linalg.norm(emb)
        # Cosine similarity
        sim = np.dot(q_norm, emb_norm)
        similarities.append((key, sim))
    
    # Sort by similarity descending
    similarities.sort(key=lambda x: x[1], reverse=True)
    
    return [file_name for file_name, _ in similarities][:k]

def cluster_embeddings(embeddings, num_clusters):
    model = KMeans(n_clusters=num_clusters, random_state=42)
    labels = model.fit_predict(embeddings)
    
    return labels, model
